{
  "manifest_version": 3,
  "name": "Teixo GMB — Responder Avaliações",
  "version": "2.0.0",
  "description": "Abre uma nova aba no seu Brave atual e responde avaliações do Google Meu Negócio sem fechar o navegador.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.google.com.br/*",
    "https://business.google.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Teixo GMB — Avaliações"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://www.google.com.br/*",
        "https://business.google.com/*"
      ],
      "all_frames": true,
      "js": [
        "content-search.js",
        "content-reviews.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
